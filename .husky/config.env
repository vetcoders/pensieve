# vibecrafted-hooks-template — repo-local configuration (auto-generated)
#
# Generated by install.sh --auto on 2026-07-02T05:35:34Z.
# Detection summary:
#   Repository profile (/Users/maciejgad/vc-workspace/vetcoders/pensieve):
#     Languages:      shell
#     Tools:          semgrep loct rustfmt clippy ruff shellcheck prettier
#     Shape:          single-package
#     Existing hooks: none
#     Activator:      lefthook
#
# Edit values freely — re-running install.sh preserves this file unless
# --force is passed.

# ── WARN mode ────────────────────────────────────────────────────────
HUSKY_WARN_MODE_ON_FEATURE=1
HUSKY_WARN_PROTECTED_BRANCHES='^(main|develop|release/.*|hotfix/.*)$'
HUSKY_WARN_RETENTION=5

# ── Pre-commit (stage-scoped) ───────────────────────────────────────
# Security guards (secrets, env files) are run by hook entry as STRICT,
# never demoted to WARN. Flags 0/1 here just enable/disable the checks
# themselves — when on, they are non-negotiable.
HUSKY_PRECOMMIT_SECRETS=1
HUSKY_PRECOMMIT_ENV_FILES=1

HUSKY_PRECOMMIT_LINT_STAGED=0
HUSKY_PRECOMMIT_PRETTIER_STAGED=1
HUSKY_PRECOMMIT_ESLINT_STAGED=0
HUSKY_PRECOMMIT_STYLELINT_STAGED=0
HUSKY_PRECOMMIT_TSC=0    # workspace-aware tsc not solved in template
HUSKY_PRECOMMIT_SEMGREP_STAGED=1
HUSKY_PRECOMMIT_LOCT_HEALTH=1
HUSKY_PRECOMMIT_LOCT_SUPPRESSIONS=0
HUSKY_PRECOMMIT_LOCT_SUPPRESSIONS_BUDGET=30

HUSKY_PRECOMMIT_RUSTFMT_STAGED=0
HUSKY_PRECOMMIT_RUST_CARGO_CHECK=0
HUSKY_RUST_CARGO_DIR='.'

HUSKY_PRECOMMIT_PY_RUFF=0
HUSKY_PRECOMMIT_PY_BLACK=0
HUSKY_PRECOMMIT_SH_SHELLCHECK=1

# ── Pre-push (full-repo, slower) ───────────────────────────────────
HUSKY_PREPUSH_PRETTIER_FULL=0
HUSKY_PREPUSH_SEMGREP_FULL=1
HUSKY_PREPUSH_TSC=0
HUSKY_PREPUSH_LOCT_CYCLES=1
HUSKY_PREPUSH_LOCT_COMMANDS=0
HUSKY_PREPUSH_VITEST=0
HUSKY_PREPUSH_CARGO_CLIPPY=0
HUSKY_PREPUSH_CARGO_TEST=0
HUSKY_PREPUSH_SECRETS=1

# ── Commit-msg ──────────────────────────────────────────────────────
HUSKY_COMMIT_MSG_CONVENTIONAL=1
HUSKY_COMMIT_MSG_ALLOW_AGENT_PREFIX=1
HUSKY_COMMIT_MSG_REQUIRE_AGENT_RUNTIME=1
HUSKY_COMMIT_MSG_SUBJECT_MAX=100

# ── Pre-merge-commit ───────────────────────────────────────────────
HUSKY_PREMERGE_CLEAN_CODEX_AGENT=1
HUSKY_PREMERGE_CLEAN_PATHS=''

# ── Post-commit ────────────────────────────────────────────────────
HUSKY_POSTCOMMIT_CLAUDE_ARTIFACT_WARN=1

# ── Excludes / blocklists ──────────────────────────────────────────
HUSKY_EXCLUDE_PATHS='
node_modules/
dist/
.loctree/
target/
vendor/
.next/
build/
.husky/_/
'

HUSKY_BLOCKED_PATHS='
.env
.env.local
.env.production
.env.staging
LibraxisAI-*.md
CLAUDE.local.md
'
