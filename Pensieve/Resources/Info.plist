        <string>0.0.0</string>
    </dict>
    <key>CFBundleExecutable</key>
    <string>Pensieve</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key>
    <string>𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <!-- MUST stay false. Sudden termination lets the system SIGKILL the app
         instead of asking it to quit, which skips BOTH halves of our shutdown
         contract: applicationShouldTerminate (the unsaved-work prompt pass, the
         only veto point a Dock quit or logout ever reaches) and
         applicationWillTerminate (FolderManager.flushWorkingSet, the last
         writable moment for the Open Files working set). Measured on a staged
         bundle: with this true, applicationWillTerminate never fired at all.
         An app holding unsaved user work cannot advertise that it is safe to
         kill without notice. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Pensieve needs access to your microphone to transcribe your speech into text.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Pensieve needs access to speech recognition to transcribe your voice notes.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
