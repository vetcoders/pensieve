<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Pensieve supports operator-configured provider endpoints. Static ATS
     certificate pins would reject legitimate custom providers and routine
     certificate rotation; system trust plus ATS remains the intended policy. -->
<dict>
    <key>CFBundleIdentifier</key>
    <string>io.vetcoders.pensieve</string>
    <key>CFBundleName</key>
    <string>Pensieve</string>
    <key>CFBundleDisplayName</key>
    <string>Pensieve</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleGetInfoString</key>
    <string>Pensieve 0.0.0 (dev)</string>
    <key>PensieveBuildCommit</key>
    <string>unknown</string>
    <key>PensieveBuildCommitSlug</key>
    <string>dev</string>
    <key>PensieveBuildDate</key>
    <string>unknown</string>
    <key>PensieveComponentVersions</key>
    <dict>
        <key>Editor</key>
        <string>0.0.0</string>
        <key>MarkdownRenderer</key>
        <string>0.0.0</string>
        <key>Mermaid</key>
        <string>0.0.0</string>
        <key>Preview</key>
        <string>0.0.0</string>
        <key>Search</key>
        <string>0.0.0</string>
        <key>Storage</key>
        <string>0.0.0</string>
        <key>Workspace</key>
        <string>0.0.0</string>
    </dict>
    <key>CFBundleExecutable</key>
    <string>Pensieve</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key>
    <string>𝚅𝚒𝚋𝚎𝚌𝚛𝚊𝚏𝚝𝚎𝚍. with AI Agents by Vetcoders (c)2024-2026 LibraxisAI</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <!-- Sudden termination is a promise to the OS that this process can be killed with
         `exit()` at any instant, skipping `applicationShouldTerminate:` and
         `applicationWillTerminate:` entirely. Pensieve cannot keep that promise: it carries a
         SQLite WAL that only a truncating checkpoint returns to disk, and the checkpoint hangs
         off `applicationWillTerminate`. Falsified at runtime on 2026-07-29 — with this key
         `true`, a packaged build quit by Apple Event (Dock / logout) *and* by
         `NSApp.terminate(nil)` exited without ever entering the delegate hook, while the
         unbundled binary (no Info.plist, so no such promise) entered it every time. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Pensieve needs access to your microphone to transcribe your speech into text.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Pensieve needs access to speech recognition to transcribe your voice notes.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
